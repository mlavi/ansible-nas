# shellcheck shell=bash

direnv.extension.mlavi.create_env
dotenv || direnv status # https://direnv.net/man/direnv-stdlib.1.html
direnv.extension.mlavi.git_repo

ssh-add -L
echo
ip -4 -c a show dev "${HOST_INTERFACE}"
echo
route | grep -e "${HOST_INTERFACE}" -e Iface
echo

cat <<-'MotD'
---
Rebase from upstream, see notes: ansible-collection/mlavi/developer/docs/README.md
- ansible-galaxy collection install --upgrade --requirements-file requirements.yml
# initial *tainer task failure solution = build Docker images remotely in separate terminal:
  gcd ansible-collection && cd mlavi/homelab/roles && pushd phptainer
  popd && pushd webtainer

Debug:
- r = retry failed task; insure inventory/*, .env.sample, default/main.yml in sync!
- p task_vars["varname"] || task || task.args
ansible-navigator
ANSIBLE_DEBUG=1 ansible-inventory --list
- alias ansible-facts = "ansible --module-name ansible.builtin.setup  pi6 > pi6.ansible_facts.ignore.json"
- ansible-inventory --host pi6 | grep role_
assh config search www2

ping -i 3 -U -W 5 -c 1 pi6 && ssh $_
ansible-playbook mlavi.developer.{debug,asdf} --limit pi16 && ssh $_
ANSIBLE_ENABLE_TASK_DEBUGGER=false ansible-playbook ...

mise run ap # ansible-playbook

ansible-playbook mlavi.homelab.ansible_nas_io --tags "traefik,homepage" --limit pi4
ansible-playbook mlavi.homelab.ansible_nas_io --list-tasks --tags "jellyfin,webtainer"

ansible-playbook mlavi.developer.openwrt_25plus --extra-vars day2=dns --limit 192.168.2.1
ansible-playbook mlavi.developer.lamp --limit www2.lavi.us --extra-vars day2={apache2,docroots}
ansible-playbook mlavi.developer.ansible_nas_io --tags stirling_pdf --limit pi6
ansible-playbook mlavi.developer.localai # xdg-open http://x570-aorus-elite:8080/app

MotD
# direnv.extension.mlavi.autostart
# direnv.extension.mlavi.readme requirements-mlavi.homelab.yaml
