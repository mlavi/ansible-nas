# shellcheck shell=bash

direnv.extension.mlavi.create_env
dotenv || direnv status # https://direnv.net/man/direnv-stdlib.1.html
direnv.extension.mlavi.git_repo

cat <<- 'MotD'
Rebase from upstream, see notes: ansible-collection/mlavi/developer/docs/README.md

ssh pi3 "which python || python --version"
ansible-playbook nas.yml --limit pi3
# stops at: TASK [vladgh.samba.server : Create Samba users if they don't exist yet]

ansible-playbook mlavi.homelab.ansible_nas_io --list-tasks --tags "jellyfin,webtainer"
ansible-playbook mlavi.homelab.ansible_nas_io --tags homepage --limit pi1
ANSIBLE_ENABLE_TASK_DEBUGGER=false ansible-playbook mlavi.developer.openwrt_backup

ansible-playbook mlavi.homelab.ansible_nas_io --limit pi3 --start-at-task=mlavi.homelab.webtainer*

# initial *tainer task failure solution = build Docker images remotely in separate terminal:
  gcd ansible-collection && cd mlavi/homelab/roles && pushd phptainer
  popd && pushd webtainer
# r = retry failed task; insure inventory/*, .env.sample, default/main.yml in sync!
# then: docroot.sh all

# --- original notes:
ANSIBLE_SKIP_TAGS+=', homeassistant' ansible-playbook --limit pi --start-at-task=mlavi.homelab.h*
--start-at-task=homeassistant*
--start-at-task=ansible-nas-docker*

MotD

# direnv.extension.mlavi.autostart
# direnv.extension.mlavi.readme requirements-mlavi.homelab.yaml
